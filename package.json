{
  "name": "conductor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "conductor": "bin/conductor.mjs",
    "conductord": "bin/conductord.mjs"
  },
  "scripts": {
    "test": "env -u CONDUCTOR_IN_JOB -u CONDUCTOR_HELD_LOCKS -u CONDUCTOR_JOB_ID node --test --test-reporter=spec",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test",
    "mutate:core": "node scripts/mutate.mjs core",
    "mutate:escape": "node scripts/mutate.mjs escape",
    "mutate:wrap": "node scripts/mutate.mjs wrap",
    "mutate:group": "node scripts/mutate.mjs group",
    "mutate:shim": "node scripts/mutate.mjs shim",
    "mutate:hooks": "node scripts/mutate.mjs hooks"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fast-check": "^4.10.0",
    "typescript": "^7.0.2"
  }
}
