{
  "name": "switchyard",
  "version": "0.20.0",
  "private": true,
  "description": "Keeps Claude Code sessions on one machine from fighting over heavy runs, by handing out CPU shares and exclusive locks.",
  "license": "MIT",
  "homepage": "https://github.com/takuyaabe11/switchyard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/takuyaabe11/switchyard.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "switchyard": "bin/switchyard.mjs",
    "switchyardd": "bin/switchyardd.mjs"
  },
  "scripts": {
    "test": "env -u SWITCHYARD_IN_JOB -u SWITCHYARD_HELD_LOCKS -u SWITCHYARD_JOB_ID SWITCHYARD_LANG=ja SWITCHYARD_UPDATE_CHECK=0 SWITCHYARD_OVERCOMMIT=0 SWITCHYARD_MEMORY=0 SWITCHYARD_HOME=$(mktemp -d) node --test --test-reporter=spec",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test",
    "mutate:core": "node scripts/mutate.mjs core",
    "mutate:escape": "node scripts/mutate.mjs escape",
    "mutate:wrap": "node scripts/mutate.mjs wrap",
    "mutate:group": "node scripts/mutate.mjs group",
    "mutate:shim": "node scripts/mutate.mjs shim",
    "mutate:hooks": "node scripts/mutate.mjs hooks",
    "mutate:report": "node scripts/mutate.mjs report",
    "mutate:pack": "node scripts/mutate.mjs pack",
    "mutate:adopt": "node scripts/mutate.mjs adopt",
    "mutate:trust": "node scripts/mutate.mjs trust",
    "mutate:diagnose": "node scripts/mutate.mjs diagnose",
    "mutate:single": "node scripts/mutate.mjs single",
    "mutate:contention": "node scripts/mutate.mjs contention"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "fast-check": "^4.10.0",
    "typescript": "^7.0.2"
  }
}
